{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/createOrderCheckout",
        "function": {
          "functionId": "createOrderCheckout",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/createPromptPayOrder",
        "function": {
          "functionId": "createPromptPayOrder",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/api/verifyPromptPaySlip",
        "function": {
          "functionId": "verifyPromptPaySlip",
          "region": "asia-southeast1"
        }
      }
    ]
  }
}
