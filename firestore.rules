rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /shops/{shopId} {
      // shop doc ถือข้อมูลส่วนบุคคล (อีเมลเจ้าของ + สถานะ subscription) →
      // อ่านได้เฉพาะเจ้าของ. หน้าสั่งของลูกค้าดึงชื่อร้านผ่าน Cloud Function
      // getShopPublic (/api/shopPublic) ที่คืนเฉพาะ field สาธารณะแทน.
      // (สินค้าใน subcollection products ยังอ่าน public ได้ — rule แยกด้านล่าง)
      allow read: if request.auth != null && request.auth.uid == shopId;
      // Owners can create their trial and edit profile data. Subscription
      // changes must go through server callables, including adminChangePlan.
      allow create: if isOwner()
        && request.resource.data.get('referredBy', null) == null
        && request.resource.data.subscriptionStatus == 'trial'
        && request.resource.data.get('subscriptionEndsAt', null) == null
        && request.resource.data.trialEndsAt is timestamp
        && request.resource.data.trialEndsAt <= request.time + duration.value(61, 'd')
        && request.resource.data.tier in ['solo', 'lite', 'full', 'restaurant']
        && request.resource.data.plan in ['monthly', 'yearly']
        && request.resource.data.locations is int
        && request.resource.data.locations >= 1
        && request.resource.data.locations <= 10000
        && request.resource.data.shopType in ['retail', 'restaurant']
        && (request.resource.data.tier != 'restaurant' || request.resource.data.shopType == 'restaurant');
      allow update: if isOwner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'tier', 'plan', 'locations', 'shopType', 'subscriptionStatus',
          'trialEndsAt', 'subscriptionEndsAt', 'createdAt', 'referredBy', 'referralCode'
        ]);
      // Prevent deleting/recreating the shop to reset a trial or admin plan.
      allow delete: if false;

      // ── Shorthand: owner of this shop ──
      function isOwner() {
        return request.auth != null && request.auth.uid == shopId;
      }
      function legacyAccounting() {
        let settings = /databases/$(database)/documents/shops/$(shopId)/accountingSettings/current;
        return !exists(settings) || get(settings).data.get('enabled', false) != true;
      }
      match /accountingSettings/{id} {
        allow read: if isOwner();
        allow write: if false;
      }
      function validSaleMovement(m, s) {
        let control = /databases/$(database)/documents/shops/$(shopId)/cashControl/current;
        let before = exists(control) ? get(control).data : {};
        let after = getAfter(control).data;
        let late = before.get('openedAt', null) != null && m.occurredAt < before.openedAt;
        let session = late ? null : before.get('sessionId', null);
        return m.kind == 'sale' && m.schemaVersion == 1
          && m.occurredAt is timestamp && m.recordedAt == request.time
          && s.total is number && s.total >= 0 && s.total <= 1000000000
          && m.salesMinor is int && m.salesMinor >= s.total * 100 - 0.5
          && m.salesMinor < s.total * 100 + 0.5
          && m.amountMinor == (s.isDebt ? 0 : m.salesMinor)
          && m.debtMinor == (s.isDebt ? m.salesMinor : 0)
          && m.method == (s.isDebt ? 'credit' : s.paymentMethod)
          && m.method in ['credit', 'cash', 'transfer', 'qr', 'online']
          && m.get('refundMinor', 0) == 0
          && m.sessionId == session && m.needsReconciliation == (session == null)
          && after.revision == before.get('revision', 0) + 1;
      }

      // สินค้าอ่านได้เฉพาะเจ้าของ — หน้าสั่งของลูกค้าดึงผ่าน Cloud Function
      // getShopPublic (whitelist field, ซ่อนราคาทุน) ไม่อ่าน Firestore ตรง
      match /products/{productId} {
        allow read: if isOwner();
        allow write: if isOwner();
      }

      match /sales/{saleId} {
        allow read: if isOwner();
        allow create: if isOwner() && legacyAccounting() && request.resource.data.get('accountingVersion', 0) != 1;
        allow update, delete: if isOwner() && legacyAccounting() && resource.data.get('accountingVersion', 0) != 1;
        allow create: if isOwner()
          && request.resource.data.accountingVersion == 1
          && request.resource.data.isRefunded == false
          && getAfter(/databases/$(database)/documents/shops/$(shopId)/moneyMovements/$('sale-' + saleId)).data.saleId == saleId;
        // Money and refund history are immutable to devices; server callables adjust them.
        allow update, delete: if false;
      }

      match /debts/{debtId} {
        allow read: if isOwner();
        allow create, update, delete: if isOwner() && legacyAccounting();
        allow create: if isOwner() && request.resource.data.paidAmount == 0
          && request.resource.data.saleId == debtId
          && getAfter(/databases/$(database)/documents/shops/$(shopId)/sales/$(debtId)).data.isDebt == true;
        allow update, delete: if false;
      }
      match /debtPayments/{paymentId} {
        allow read: if isOwner();
      }
      match /moneyMovements/{movementId} {
        allow read: if isOwner();
        allow create: if isOwner() && request.resource.data.kind == 'sale'
          && movementId == 'sale-' + request.resource.data.saleId
          && request.resource.data.recordedAt == request.time
          && getAfter(/databases/$(database)/documents/shops/$(shopId)/sales/$(request.resource.data.saleId)).data.accountingVersion == 1
          && validSaleMovement(request.resource.data,
            getAfter(/databases/$(database)/documents/shops/$(shopId)/sales/$(request.resource.data.saleId)).data);
        allow update, delete: if false;
      }
      match /cashControl/{controlId} {
        allow read: if isOwner();
        allow create: if isOwner() && controlId == 'current'
          && request.resource.data.keys().hasOnly(['revision']) && request.resource.data.revision == 1;
        allow update: if isOwner() && controlId == 'current'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision'])
          && request.resource.data.revision == resource.data.revision + 1;
      }

      match /settings/{settingId} {
        allow read, write: if isOwner();
      }
      match /kitchenPrintJobs/{jobId} {
        allow read: if isOwner();
        allow write: if false;
      }
      match /inventoryControl/{controlId} {
        allow read: if isOwner();
        allow write: if false;
      }

      // orders สร้างและอ่านโดย Function (admin) เท่านั้น
      // เจ้าของร้านอ่าน/อัพเดตได้ผ่าน auth
      match /orders/{orderId} {
        allow read: if isOwner();
        allow create, update, delete: if isOwner() && legacyAccounting();
        allow update: if isOwner() && resource.data.status == 'pendingPayment'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'bankMatchStatus', 'bankMatchAt', 'bankMatchRef', 'paymentSender', 'autoConfirmed'
          ]) && request.resource.data.autoConfirmed == false;
      }

      // ── Restaurant mode (PR 2-4) ──
      match /tables/{tableId} {
        allow read, write: if isOwner();
      }
      match /tableOrders/{orderId} {
        allow read, write: if isOwner();
      }
      match /modifierGroups/{groupId} {
        allow read, write: if isOwner();
      }

      // ── Recipe/ingredient inventory (Restaurant) ──
      // Managed in-app by the owner; the sale-deduction trigger uses the
      // admin SDK and bypasses rules.
      match /ingredients/{ingredientId} {
        allow read, write: if isOwner();
      }
      match /ingredientPurchases/{purchaseId} {
        allow read, write: if isOwner();
      }
      match /inventoryWaste/{wasteId} {
        allow read, create: if isOwner();
        allow update, delete: if false;
      }

      // ── Receipt counter + end-of-day cash sessions ──
      match /counters/{counterId} {
        allow read, write: if isOwner();
      }
      match /cashSessions/{sessionId} {
        allow read: if isOwner();
        allow create: if isOwner() && legacyAccounting() && request.resource.data.get('accountingVersion', 0) != 1;
        allow update, delete: if isOwner() && legacyAccounting() && resource.data.get('accountingVersion', 0) != 1;
      }

      // ── Hardware shipments (Phase D) ──
      // เจ้าของร้านอ่าน tracker ได้; การ advance สถานะทำผ่าน admin SDK
      // (founder console) ซึ่ง bypass rules อยู่แล้ว แต่เปิด write ให้
      // owner ด้วยเพื่อให้ createForSignup ตอนสมัครเขียนได้
      match /hardware/{requestId} {
        allow read, write: if isOwner();
      }

      // ── Marketplace orders — shop's own copy (Phase E) ──
      match /marketplaceOrders/{orderId} {
        allow read: if isOwner();
        allow write: if false; // Server validates prices and mirrors both parties atomically.
      }

      // ── Saved supplier products (favorites) — shop's own list ──
      // Doc id is "{supplierId}_{productId}"; lets the shop re-add staples
      // fast when reordering. Private to the shop.
      match /supplierFavorites/{favId} {
        allow read, write: if isOwner();
      }

      // ── Staff profiles (PIN-based, attribution only) ──
      match /staff/{staffId} {
        allow read, write: if isOwner();
      }

      // ── Loyalty customers ──
      match /customers/{customerId} {
        allow read, write: if isOwner();
      }

      // ── AI usage quota ──
      // เขียนโดย aiChat Function (admin SDK, bypass) เท่านั้น;
      // อนุญาตให้ owner อ่าน เผื่อแสดงโควต้าในแอป
      match /aiUsage/{day} {
        allow read: if isOwner();
      }
    }

    // ── Global config ──
    // Plan catalog: public pricing (also shown on the landing page) —
    // readable by any signed-in user (the /subscribe page reads it after
    // login). Writes go through adminUpsertPlans (admin SDK bypasses rules).
    match /config/plans {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Billing config holds the company PromptPay account + founder LINE id
    // — never client-readable; served via callables only.
    match /config/billing {
      allow read, write: if false;
    }
    // Short-link slugs (pok-pok.app/r/<slug>) — claimed via the setShopSlug
    // callable, resolved by the goShop redirect (both admin SDK). Deny all
    // direct client access.
    match /slugs/{slug} {
      allow read, write: if false;
    }
    // subscriptionPayments + usedSubscriptionSlipRefs (top-level) carry no
    // rules on purpose: default-deny, admin SDK only.

    // ── Suppliers — top-level, shared across shops (Phase E) ──
    // The supplier owns their doc when its id == their auth uid — the
    // account is created white-glove by the founder via admin SDK
    // (adminCreateSupplierAccount), then the supplier signs into the web
    // portal to self-manage profile + catalog. Any logged-in shop can
    // browse.
    match /suppliers/{supplierId} {
      function isSupplier() {
        return request.auth != null && request.auth.uid == supplierId;
      }

      allow read: if request.auth != null;
      // Profile edits by the supplier themselves; create/delete stay
      // admin-only (founder onboarding).
      allow update: if isSupplier();
      allow create, delete: if false; // admin SDK only

      match /products/{productId} {
        allow read: if request.auth != null;
        allow write: if isSupplier(); // supplier manages own catalog
      }

      // Both copies are server-owned; clients cannot change identities,
      // prices, fees or lifecycle state by bypassing the application.
      match /orders/{orderId} {
        allow read: if request.auth != null
          && (resource.data.shopId == request.auth.uid || isSupplier());
        allow write: if false;
      }
    }
  }
}
