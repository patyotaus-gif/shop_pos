rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /shops/{shopId} {
      // ลูกค้าอ่านชื่อร้านได้ (สำหรับหน้าสั่งออนไลน์)
      allow read: if true;
      // เฉพาะเจ้าของร้านเท่านั้นที่แก้ไขข้อมูลร้านได้
      allow write: if request.auth != null && request.auth.uid == shopId;

      // ลูกค้าอ่านสินค้าได้ (สำหรับหน้าสั่งออนไลน์)
      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == shopId;
      }

      match /sales/{saleId} {
        allow read, write: if request.auth != null && request.auth.uid == shopId;
      }

      match /debts/{debtId} {
        allow read, write: if request.auth != null && request.auth.uid == shopId;
      }

      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == shopId;
      }

      // orders สร้างและอ่านโดย Function (admin) เท่านั้น
      // เจ้าของร้านอ่าน/อัพเดตได้ผ่าน auth
      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == shopId;
      }
    }
  }
}
