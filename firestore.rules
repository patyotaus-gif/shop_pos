rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /shops/{shopId} {
      // ลูกค้าอ่านชื่อร้านได้ (สำหรับหน้าสั่งออนไลน์)
      allow read: if true;
      // เฉพาะเจ้าของร้านเท่านั้นที่แก้ไขข้อมูลร้านได้
      allow write: if request.auth != null && request.auth.uid == shopId;

      // ── Shorthand: owner of this shop ──
      function isOwner() {
        return request.auth != null && request.auth.uid == shopId;
      }

      // ลูกค้าอ่านสินค้าได้ (สำหรับหน้าสั่งออนไลน์)
      match /products/{productId} {
        allow read: if true;
        allow write: if isOwner();
      }

      match /sales/{saleId} {
        allow read, write: if isOwner();
      }

      match /debts/{debtId} {
        allow read, write: if isOwner();
      }

      match /settings/{settingId} {
        allow read, write: if isOwner();
      }

      // orders สร้างและอ่านโดย Function (admin) เท่านั้น
      // เจ้าของร้านอ่าน/อัพเดตได้ผ่าน auth
      match /orders/{orderId} {
        allow read, write: if isOwner();
      }

      // ── Restaurant mode (PR 2-4) ──
      match /tables/{tableId} {
        allow read, write: if isOwner();
      }
      match /tableOrders/{orderId} {
        allow read, write: if isOwner();
      }
      match /modifierGroups/{groupId} {
        allow read, write: if isOwner();
      }

      // ── Hardware shipments (Phase D) ──
      // เจ้าของร้านอ่าน tracker ได้; การ advance สถานะทำผ่าน admin SDK
      // (founder console) ซึ่ง bypass rules อยู่แล้ว แต่เปิด write ให้
      // owner ด้วยเพื่อให้ createForSignup ตอนสมัครเขียนได้
      match /hardware/{requestId} {
        allow read, write: if isOwner();
      }

      // ── Marketplace orders — shop's own copy (Phase E) ──
      match /marketplaceOrders/{orderId} {
        allow read, write: if isOwner();
      }

      // ── Staff profiles (PIN-based, attribution only) ──
      match /staff/{staffId} {
        allow read, write: if isOwner();
      }

      // ── Loyalty customers ──
      match /customers/{customerId} {
        allow read, write: if isOwner();
      }

      // ── AI usage quota ──
      // เขียนโดย aiChat Function (admin SDK, bypass) เท่านั้น;
      // อนุญาตให้ owner อ่าน เผื่อแสดงโควต้าในแอป
      match /aiUsage/{day} {
        allow read: if isOwner();
      }
    }

    // ── Suppliers — top-level, shared across shops (Phase E) ──
    // Onboarded white-glove by the founder via admin SDK (bypasses
    // rules), so no client write to the supplier doc / catalog. Any
    // logged-in shop can browse.
    match /suppliers/{supplierId} {
      allow read: if request.auth != null;
      allow write: if false; // admin SDK only

      match /products/{productId} {
        allow read: if request.auth != null;
        allow write: if false; // admin SDK only
      }

      // Supplier-side copy of a marketplace order. The placing shop owns
      // it (matches shopId) so it can create + later cancel/confirm via
      // the dual-write. A dedicated supplier app + auth comes later.
      match /orders/{orderId} {
        allow create: if request.auth != null
          && request.resource.data.shopId == request.auth.uid;
        allow read, update: if request.auth != null
          && resource.data.shopId == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
