.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase
# (config files are not secret — they're shipped in the app bundle anyway,
#  protected by Firebase Security Rules + SHA fingerprints)

# Environment
.env
*.env

# Android release signing — NEVER commit these, NEVER lose the .jks
android/key.properties
android/*.jks
android/*.keystore

# Codemagic
.codemagic-cache/

# Firebase CLI cache
.firebase/

# Node modules (functions)
functions/node_modules/
node_modules/

# Accidentally vendored SDK / junk
/flutter/
header*.html
icon_generator.html
icon_512.html
header_image.html
hs_err_pid*.log
*.iml
