rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Shop branding is public on ordering pages; only its owner may change it.
    match /shops/{shopId}/logo.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == shopId
        && (request.resource == null
            || (request.resource.size <= 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
    // รูปสินค้า — เจ้าของร้านเขียน ลูกค้าอ่านได้
    match /shops/{shopId}/products/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == shopId;
    }
    // รูปสินค้าซัพพลายเออร์ — supplier เขียนของตัวเอง ร้านอ่านได้
    // จำกัดขนาด < 2MB และต้องเป็นไฟล์รูปเท่านั้น
    match /suppliers/{supplierId}/products/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == supplierId
        && (request.resource == null
            || (request.resource.size < 2 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
  }
}
