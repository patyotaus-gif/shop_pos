rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verifiedAccount() {
      return request.auth != null && (
        request.auth.token.get('email_verified', false) == true ||
        request.auth.token.get('firebase', {}).get('sign_in_provider', '') in ['google.com', 'apple.com'] ||
        (request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'custom' &&
          request.auth.token.get('ownerQuickUnlock', false) == true &&
          request.auth.token.get('ownerSocialProvider', '') in ['google.com', 'apple.com'])
      );
    }
    // Shop branding is public on ordering pages; only its owner may change it.
    match /shops/{shopId}/logo.jpg {
      allow read: if true;
      allow write: if verifiedAccount()
        && request.auth.uid == shopId
        && (request.resource == null
            || (request.resource.size <= 5 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
    // รูปสินค้า — เจ้าของร้านเขียน ลูกค้าอ่านได้
    match /shops/{shopId}/products/{file} {
      allow read: if true;
      allow write: if verifiedAccount() && request.auth.uid == shopId
        && (request.resource == null
            || (request.resource.size <= 5 * 1024 * 1024
                && request.resource.contentType in [
                  'image/jpeg', 'image/png', 'image/webp', 'image/gif',
                  'image/heic', 'image/heif'
                ]));
    }
    // รูปสินค้าซัพพลายเออร์ — supplier เขียนของตัวเอง ร้านอ่านได้
    // จำกัดขนาด < 2MB และต้องเป็นไฟล์รูปเท่านั้น
    match /suppliers/{supplierId}/products/{file} {
      allow read: if true;
      allow write: if verifiedAccount()
        && request.auth.uid == supplierId
        && (request.resource == null
            || (request.resource.size < 2 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
  }
}
